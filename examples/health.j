/**
 * health example - hardware health sensors (temperature, voltage, fans).
 *
 * Read-only unless noted; mutating calls are shown as comments.
 * Set the router credentials in the environment:
 *   MT_HOST=192.168.88.1 MT_USER=admin MT_PASSWORD=secret jennifer run examples/health.j
 */

use io;
use os;

import "../src/routeros.j" as mt;

def host as string init os.getEnv("MT_HOST");
def user as string init os.getEnv("MT_USER");
def password as string init os.getEnv("MT_PASSWORD");

if ($host == "" or $user == "") {
    io.printf("set MT_HOST, MT_USER and MT_PASSWORD first\n");
    exit 1;
}

def c as mt.Client init mt.connect($host, $user, $password);

def sensors as list of mt.HealthSensor init mt.healthSensors($c);
if (len($sensors) == 0) {
    io.printf("this model reports no health sensors\n");
}
for (def s in $sensors) {
    io.printf("%s: %s %s\n", $s.name, $s.value, $s.kind);
}

mt.disconnect($c);
